[Unit]
Description=judgement-lane auth exchange slice over Telegram (timer re-arms until it succeeds)
Wants=network-online.target
After=network-online.target agentcy-bot.service
ConditionPathExists=!/var/lib/stock-agentcy/.openclaw-authed

[Service]
Type=exec
User=root
ExecStart=/opt/stock-agentcy/deploy/openclaw/bootstrap-auth.sh
# The exchange pauses the agentcy bot (getUpdates is exclusive per token); the
# bot must come back on EVERY termination path, including SIGKILL/OOM where a
# bash trap never runs.
ExecStopPost=/usr/bin/systemctl start agentcy-bot.service
Restart=no
