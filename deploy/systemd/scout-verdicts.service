[Unit]
Description=scout weekly verdicts (judgement lane: claude answers the pre-committed questions)
Wants=network-online.target
# After scout-monitor-brief (no Wants= — that would re-run the brief on every
# fire): on a Persistent=true catch-up boot all Saturday timers queue at once,
# and the verdicts must not race the brief that writes and opens the spool.
After=network-online.target scout-monitor-brief.service
OnFailure=agentcy-fail@%n.service

[Service]
Type=oneshot
User=openclaw
TimeoutStartSec=3h
EnvironmentFile=-/etc/stock-agentcy/openclaw.env
Environment=HOME=/home/openclaw
# systemd (pid 1) reads the EnvironmentFile before building the namespace, so
# the token still reaches the process env while the FILE is unreadable inside
# — the agent gets its credential but can never cat it.
InaccessiblePaths=-/etc/stock-agentcy/openclaw.env
WorkingDirectory=/var/lib/stock-agentcy/scout
ExecStart=/opt/stock-agentcy/deploy/openclaw/verdicts.sh
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-agentcy/scout
ReadWritePaths=/home/openclaw
PrivateTmp=true
