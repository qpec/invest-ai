[Unit]
Description=scout price grid refresh (nightly 02:45 Amsterdam — after the filings sweep)

[Timer]
# Nightly, and 30 minutes after scout-refresh so the two network jobs do not contend.
# Nightly rather than weekly because the grid's whole job is to be current: Saturday's
# site build and monitor run both read it, and PRICE_MAX_AGE_DAYS refuses a grid that
# has drifted, so a missed week would blank the valuation pillar rather than age it.
OnCalendar=*-*-* 02:45:00 Europe/Amsterdam
Persistent=true

[Install]
WantedBy=timers.target
