[Unit]
Description=stock-agentcy nightly backup (both DBs + archive mirror + toolchain -> second disk)
OnFailure=agentcy-fail@%n.service

[Service]
Type=oneshot
User=agentcy
TimeoutStartSec=30min
EnvironmentFile=/etc/stock-agentcy/agentcy.env
ExecStart=/opt/stock-agentcy/.venv/bin/python -m agentcy.jobs.backup
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-agentcy
ReadWritePaths=/mnt/agentcy-backup
PrivateTmp=true
