[Unit]
Description=scout desk-site rebuild + bot/site push + private state-archive push
Wants=network-online.target
After=network-online.target
OnFailure=agentcy-fail@%n.service

[Service]
Type=oneshot
User=agentcy
TimeoutStartSec=1h
EnvironmentFile=/etc/stock-agentcy/scout.env
WorkingDirectory=/opt/stock-agentcy/stock-scout
ExecStart=/opt/stock-agentcy/deploy/scout/publish.sh
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-agentcy/scout
PrivateTmp=true
