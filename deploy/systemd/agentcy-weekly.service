[Unit]
Description=stock-agentcy weekly review (D.2 + statement-fingerprint event detection)
Wants=network-online.target
After=network-online.target
OnFailure=agentcy-fail@%n.service

[Service]
Type=oneshot
User=agentcy
TimeoutStartSec=30min
EnvironmentFile=/etc/stock-agentcy/agentcy.env
Environment=MPLBACKEND=Agg
ExecStart=/opt/stock-agentcy/.venv/bin/agentcy run weekly
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-agentcy
PrivateTmp=true
