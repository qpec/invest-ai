# /etc/stock-agentcy/scout.env — the mechanical lane's secrets + knobs.
# Install as root:agentcy 0640: the agentcy user (systemd units) reads it,
# the openclaw user (judgement lane) MUST NOT — no git credentials in the
# judgement lane is one of the §4 seam guarantees, verified at install.

# Fine-grained PAT: contents read/write on qpec/invest-ai + qpec/invest-ai-state
# ONLY, no workflow scope (so the box can never rewire CI). Rotate ~90 days.
GH_PAT=REPLACE_ME

# The model the judgement lane is pinned to (must be in deskwork.APPROVED_MODELS;
# monitor.py refuses verdicts declared from anything else).
SCOUT_AGENT_MODEL=claude-opus-5

# The §3.6 weekly price grid. DEFAULTS to /var/lib/stock-agentcy/scout/prices (lib.sh);
# set this only to point somewhere else. Without prices there is no market cap, so no
# owner-FCF yield and no verdict — "no price, no verdict" (SCORECARD-DESIGN §4.1) — which
# is why it is no longer opt-in. scout-prices.timer keeps it current; pit refuses a close
# older than PRICE_MAX_AGE_DAYS rather than multiplying it by a fresh share count.
#SCOUT_PRICES=/var/lib/stock-agentcy/scout/prices
#SCOUT_PRICES_BUDGET=800

# Optional: extra comma-separated symbols for the Saturday enrichment refresh
# beyond committed+draft theses (the shortlist you are actively watching).
#SCOUT_EXTRA_SYMBOLS=

# Freshness-sweep budgets (fetches per run; thesis names always lead and are
# never cut). Nightly 02:15 rolling refresh; Saturday 06:00 final pass. At
# EDGAR pacing a 1500-name budget is ~10 minutes.
#SCOUT_REFRESH_BUDGET=1500
#SCOUT_SCRAPE_BUDGET=800

# Optional overrides (defaults shown):
#SCOUT_SITE_REPO=https://x-access-token@github.com/qpec/invest-ai.git
#SCOUT_STATE_REPO=https://x-access-token@github.com/qpec/invest-ai-state.git
#SCOUT_SITE_BRANCH=bot/site

# The production desk UI (scout-desk.service) listens here, on loopback only.
# Reach it with:  ssh -N -L 8899:127.0.0.1:8899 root@<box>
#SCOUT_DESK_PORT=8899
