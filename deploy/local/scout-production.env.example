# Container-local production paths. Copy outside Git and adjust for this runtime.
SCOUT_REPO=/home/openclaw/projects/invest-ai
SCOUT_DB_DIR=/home/openclaw/projects/invest-ai/var/scout/agentcy-local-v4
SCOUT_ARTIFACT_ROOT=/home/openclaw/projects/invest-ai/var/scout/production
SCOUT_SEC_DATA=/home/openclaw/projects/invest-ai/stock-scout/sample-data/secdata
SCOUT_PRICE_GRID=/home/openclaw/projects/invest-ai/var/scout/production/price-grid
SCOUT_UNIVERSE=/home/openclaw/projects/invest-ai/var/scout/universe/all.csv
SCOUT_ENRICH_CACHE=/home/openclaw/projects/invest-ai/var/scout/sec-companyfacts
SCOUT_THESES_DIR=/home/openclaw/projects/invest-ai/var/scout/theses
SCOUT_REPORTS_DIR=/home/openclaw/projects/invest-ai/var/scout/reports
SCOUT_THESIS_RUNNER=/home/openclaw/projects/invest-ai/deploy/local/scout-thesis-runner.sh
SCOUT_THESIS_MODEL=gpt-5.6-sol
SCOUT_SITE_REPO=https://github.com/qpec/invest-ai.git
SCOUT_SITE_CHECKOUT=/home/openclaw/projects/invest-ai/var/scout/site-repo
# MUST be the branch GitHub Pages serves (Settings -> Pages -> Source).
# Verified 2026-08-08: this repo serves main/docs. The publisher used to target
# bot/site while Pages served main, so months of runs published to a branch
# nobody read; the run now verifies SCOUT_SITE_URL and fails if the two disagree.
SCOUT_SITE_BRANCH=main
# The public page, read back after every push to prove publication really happened.
SCOUT_SITE_URL=https://qpec.github.io/invest-ai/
SCOUT_PYTHON=/home/openclaw/projects/invest-ai/.venv/bin/python
SCOUT_GIT_ASKPASS=/home/openclaw/projects/invest-ai/deploy/local/git-askpass.sh

# The fine-grained PAT the publisher hands to git via SCOUT_GIT_ASKPASS.
# Contents-only, scoped to this repo; needed to push the built site to SCOUT_SITE_BRANCH.
GH_PAT=
